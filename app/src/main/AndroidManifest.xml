<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No INTERNET permission: codes are computed offline from the stored secret. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!--
      allowBackup is off on purpose. The secrets are sealed with a non-exportable
      AndroidKeyStore key, so a restored database on another device would hold
      blobs nothing can decrypt — worse than starting empty.
    -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Authenticator"
        android:supportsRtl="true"
        android:theme="@style/Theme.LightAuth">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="Authenticator"
            android:theme="@style/Theme.LightAuth">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          One code for another app. Web Tools starts this for a result from a sign-in page; the
          PIN (if set) is asked here, a row is tapped, and the six digits go back once. Exported
          because that is the whole point; nothing is readable without a tap on this screen.
        -->
        <activity
            android:name=".PickCodeActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.LightAuth">
            <intent-filter>
                <action android:name="com.gios.lightauth.PICK_CODE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          LightSync's hook. Exported with no permission attribute on purpose: the provider
          rejects any caller that is not LightSync by package *and* signing certificate, which
          is a check no manifest attribute can express between apps signed with different keys.
          The authority suffix is how LightSync discovers the app at all.
        -->
        <provider
            android:name=".backup.Backup"
            android:authorities="${applicationId}.lightsync.backup"
            android:exported="true" />
    </application>
</manifest>
